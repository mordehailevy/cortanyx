# Copy this file to .env and fill in the values. Never commit .env.

# OpenAI (server side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_OUTPUT_TOKENS=2048

# MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/chatgpt_clone?charset=utf8mb4
DATABASE_URL=mysql+pymysql://chat_app:change_me@localhost:3306/chatgpt_clone?charset=utf8mb4

# Frontend origin(s), comma separated
CORS_ORIGINS=http://localhost:5173

CONTEXT_MAX_MESSAGES=40
# and at most this many characters of history (~12k tokens)
CONTEXT_MAX_CHARS=48000
RATE_LIMIT_PER_MINUTE=20
MAX_MESSAGE_CHARS=8000
# Refuse new answers once the last 24 h used this many tokens (0 = no limit)
DAILY_TOKEN_BUDGET=500000
# Host names the API answers to (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1
# Swagger docs at /docs (set false in production)
ENABLE_DOCS=true
